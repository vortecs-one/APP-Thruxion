<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recyclerview_transform"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ===================================================== -->
    <!-- MAP CARD -->
    <!-- ===================================================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/map_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_list_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <org.maplibre.android.maps.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- COORDINATE DISPLAY (Top Left of Map) -->
        <TextView
            android:id="@+id/tvMapCoordinates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="#80000000"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:visibility="gone"
            tools:text="Lat: -33.4489, Lon: -70.6693"
            tools:visibility="visible" />

    </com.google.android.material.card.MaterialCardView>

    <!-- ===================================================== -->
    <!-- MY LOCATION FAB -->
    <!-- ===================================================== -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_my_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="@string/my_location"
        app:fabSize="mini"
        app:srcCompat="@drawable/ic_my_location"
        app:tint="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="@id/map_card"
        app:layout_constraintEnd_toEndOf="@id/map_card" />

    <!-- ===================================================== -->
    <!-- BOTTOM USER LIST -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_list_card"
        android:layout_width="0dp"
        android:layout_height="240dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="10dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/search_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_saved_places">

                <!-- SEARCH INPUT -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/search_input_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/search"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="4dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeWidth="1dp"
                    app:endIconMode="clear_text"
                    app:startIconDrawable="@android:drawable/ic_menu_search"
                    app:startIconTint="?attr/colorPrimary"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_map_layers">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_search"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:paddingVertical="10dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- MAP LAYERS BUTTON -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_map_layers"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@android:drawable/ic_menu_mapmode"
                    app:iconPadding="0dp"
                    app:iconSize="24dp"
                    app:iconTint="?attr/colorPrimary"
                    app:cornerRadius="22dp"
                    app:layout_constraintTop_toTopOf="@id/search_input_layout"
                    app:layout_constraintBottom_toBottomOf="@id/search_input_layout"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_saved_places"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Action"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_save"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/search_card"
                app:layout_constraintBottom_toBottomOf="@id/search_card"
                app:rippleColor="?attr/colorPrimary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="20dp"
                android:scrollbars="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/search_card"
                tools:listitem="@layout/item_thruxion" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- MODERN MAP STYLE PICKER (Aligned vertically above Layers Button) -->
    <LinearLayout
        android:id="@+id/llMapStylePicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/bottom_list_card"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="52dp"
        android:layout_marginBottom="12dp"
        android:translationZ="50dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStyleLight"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:icon="@drawable/ic_map_light"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorPrimary"
            app:cornerRadius="22dp"
            app:elevation="6dp"
            app:backgroundTint="#1A1A1A"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStyleDark"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:icon="@drawable/ic_map_dark"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorPrimary"
            app:cornerRadius="22dp"
            app:elevation="6dp"
            app:backgroundTint="#1A1A1A"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStyleOutdoor"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:icon="@drawable/ic_map_outdoor"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorPrimary"
            app:cornerRadius="22dp"
            app:elevation="6dp"
            app:backgroundTint="#1A1A1A"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStyleSport"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:icon="@drawable/ic_map_bike"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorPrimary"
            app:cornerRadius="22dp"
            app:elevation="6dp"
            app:backgroundTint="#1A1A1A"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="2dp" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- TOP-FLOATING DETAIL CARD -->
    <!-- ===================================================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/userDetailCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="12dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:translationZ="30dp"
        tools:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- Close Button (Top Right) -->
            <ImageButton
                android:id="@+id/btnCloseCard"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#9E9E9E"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- User/Place Avatar/Icon -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivUserAvatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:scaleType="centerCrop"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/avatar_1" />

            <!-- Information Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintStart_toEndOf="@id/ivUserAvatar"
                app:layout_constraintEnd_toStartOf="@id/btnCloseCard"
                app:layout_constraintTop_toTopOf="@id/ivUserAvatar"
                app:layout_constraintBottom_toBottomOf="@id/ivUserAvatar">

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Location Name" />

                <TextView
                    android:id="@+id/tvUserDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#757575"
                    tools:text="0.45 km · Restaurant" />
            </LinearLayout>

            <!-- Travel Modes & Times -->
            <LinearLayout
                android:id="@+id/llTravelModes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/ivUserAvatar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:id="@+id/btnModeDriving"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp">
                    <ImageView
                        android:id="@+id/ivModeDriving"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_car"
                        app:tint="?attr/colorPrimary" />
                    <TextView
                        android:id="@+id/tvTimeDriving"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        tools:text="--" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnModeWalking"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp">
                    <ImageView
                        android:id="@+id/ivModeWalking"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_walk"
                        app:tint="#757575" />
                    <TextView
                        android:id="@+id/tvTimeWalking"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        tools:text="--" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnModeCycling"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp">
                    <ImageView
                        android:id="@+id/ivModeCycling"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_bike"
                        app:tint="#757575" />
                    <TextView
                        android:id="@+id/tvTimeCycling"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        tools:text="--" />
                </LinearLayout>
            </LinearLayout>

            <!-- Compact Action Button (FOSS Navigation/Connect) -->
            <LinearLayout
                android:id="@+id/llActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/llTravelModes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartNavigation"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/start_navigation"
                    android:textSize="11sp"
                    android:visibility="gone"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#4CAF50" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNavigate"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/navigate"
                    android:textSize="11sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_walk"
                    app:iconSize="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnect"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/action"
                    android:textSize="11sp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShare"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/share"
                    android:textSize="11sp"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_menu_share"
                    app:iconSize="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSavePlace"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save"
                    android:textSize="11sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_save"
                    app:iconSize="14dp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>