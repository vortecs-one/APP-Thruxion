<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="rt_auth_store.xml"/>
        <exclude domain="sharedpref" path="rt_device_store.xml"/>
        <exclude domain="file" path="rt_auth_store"/>
        <exclude domain="file" path="rt_device_store"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="rt_auth_store.xml"/>
        <exclude domain="sharedpref" path="rt_device_store.xml"/>
        <exclude domain="file" path="rt_auth_store"/>
        <exclude domain="file" path="rt_device_store"/>
    </device-transfer>
</data-extraction-rules>
